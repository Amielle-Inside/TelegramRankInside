# TelegramRankInside - Configuracao
# Copie este arquivo para config/config.env e preencha com seus valores reais.
# NUNCA commite o config.env com dados reais no repositorio.

# Token do bot do Telegram (obtenha em @BotFather)
# Exemplo: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_TOKEN=SEU_TOKEN_AQUI

# IDs do owner (controle global do bot). Separe por virgula.
# Obtenha o ID via @userinfobot ou similar.
OWNER_IDS=SEU_ID_AQUI

# IDs de admins autorizados (apenas consultas administrativas de seus grupos)
ADMIN_IDS=SEU_ID_AQUI

# Fuso horario para calendario do ranking
TZ=America/Sao_Paulo

# Caminhos (ajuste conforme sua instalacao)
DB_PATH=data/ranking.db
JSON_DIR=data/json

# Painel web (apenas localhost, nunca exponha externamente)
WEB_HOST=127.0.0.1
WEB_PORT=2020
WEB_SECRET=SUA_SENHA_SECRETA_FORTE
WEB_USER=seu_usuario
WEB_PASSWORD=SUA_SENHA_FORTE

# Cooldown para comandos publicos no grupo (segundos)
COOLDOWN_PUBLIC_SEC=300

# Limites
MAX_QUEUE_SIZE=1000
MAX_CACHE_ENTRIES=5000
LOG_ROTATION_MB=10
